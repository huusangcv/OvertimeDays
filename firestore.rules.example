rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 1. Audit logs: Cấm tuyệt đối client đọc và ghi trực tiếp.
    // Chỉ đọc/ghi thông qua Vercel Serverless Functions (/api/audit và /api/audit-list) với quyền Admin Service Account.
    match /audit_logs/{document=**} {
      allow read, write: if false;
    }

    // 2. Cho phép các dữ liệu nghiệp vụ của nhà máy hoạt động nội bộ
    match /departments/{departmentId}/{document=**} {
      allow read, write: if true;
    }

    match /users/{document=**} {
      allow read, write: if true;
    }

    match /categories/{document=**} {
      allow read, write: if true;
    }

    match /systemSettings/{document=**} {
      allow read, write: if true;
    }

    match /departmentStats/{document=**} {
      allow read, write: if true;
    }

    match /departmentVisits/{document=**} {
      allow read, write: if true;
    }

    // Mặc định cho phép các collection nội bộ khác
    match /{document=**} {
      allow read, write: if true;
    }
  }
}
